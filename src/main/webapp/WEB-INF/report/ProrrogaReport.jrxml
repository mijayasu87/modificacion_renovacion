<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ProrrogaReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b2c1d3e4-f5a6-47b8-9c0d-1e2f3a4b5c6d">
	<property name="ireport.zoom" value="1.7715610000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="144"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<parameter name="nombrePersona" class="java.lang.String"/>
	<parameter name="delegacion" class="java.lang.String"/>
	<parameter name="id" class="java.lang.Integer"/>
	<parameter name="secretaria" class="java.lang.String"/>
	<parameter name="denosecre" class="java.lang.String"/>
	<parameter name="resolucionnot" class="java.lang.String"/>
	<parameter name="dias_letras" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    a.*
FROM
    prorroga AS a
WHERE
    a.id = $P{id}
GROUP BY
    a.id;]]>
	</queryString>
	<field name="id" class="java.lang.Integer"/>
	<field name="solicitud_senadi" class="java.lang.String"/>
	<field name="fecha_presentacion" class="java.sql.Date"/>
	<field name="notificacion" class="java.lang.Integer"/>
	<field name="fecha_notifica" class="java.sql.Date"/>
	<field name="no_registro" class="java.lang.String"/>
	<field name="fecha_registro" class="java.sql.Date"/>
	<field name="denominacion" class="java.lang.String"/>
	<field name="signo" class="java.lang.String"/>
	<field name="titular_actual" class="java.lang.String"/>
	<field name="ape_apod_repre" class="java.lang.String"/>
	<field name="fecha_elabora_notificacion" class="java.sql.Date"/>
	<field name="casillero_senadi" class="java.lang.String"/>
	<field name="casillero_judicial" class="java.lang.String"/>
	<field name="ro" class="java.lang.String"/>
	<field name="responsable" class="java.lang.String"/>
	<field name="identificacion" class="java.lang.String"/>
	<field name="cancelado" class="java.lang.String"/>
	<field name="solicitante" class="java.lang.String"/>
	<field name="numero_prorroga" class="java.lang.Integer"/>
	<field name="fecha_prorroga" class="java.sql.Date"/>
	<field name="dias_prorroga" class="java.lang.Integer"/>
	<field name="numero_alcance" class="java.lang.String"/>
	<field name="fecha_alcance" class="java.sql.Date"/>
	<variable name="solicitud_n" class="java.lang.String">
		<variableExpression><![CDATA[$F{solicitud_senadi}+" - ("+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_presentacion})+")"]]></variableExpression>
	</variable>
	<variable name="registro_n" class="java.lang.String">
		<variableExpression><![CDATA[$F{no_registro}+", de ("+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_registro})+")("+$F{signo}+")"]]></variableExpression>
	</variable>
	<variable name="titulo_prorroga" class="java.lang.String">
		<variableExpression><![CDATA["Providencia No. "+$F{numero_prorroga}+"-"+new SimpleDateFormat("yyyy").format(new java.util.Date())+"-SENADI"]]></variableExpression>
	</variable>
	<variable name="parrafo_1" class="java.lang.String">
		<variableExpression><![CDATA["<style pdfFontName='Times-Bold'>SERVICIO NACIONAL DE DERECHOS INTELECTUALES - "+
"DIRECCIÓN TÉCNICA DE MODIFICACIONES AL REGISTRO.-</style> Quito, D.M., "+
new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_prorroga})+
", a las 10h30.- \n\n"]]></variableExpression>
	</variable>
	<variable name="parrafo_2" class="java.lang.String">
		<variableExpression><![CDATA["Dentro del trámite Nro. "+$F{solicitud_senadi}+", se agrega al expediente administrativo el escrito No. "+$F{numero_alcance}+", "+
"de fecha "+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_alcance})+",  respecto de la solicitud de "+
"ampliación al "+($F{solicitud_senadi}.contains("SENADI")?"término":"plazo")+" otorgado.\n\n"+
"Esta autoridad, al amparo de lo dispuesto en el art. "+($F{solicitud_senadi}.contains("SENADI")?"161 del Código Orgánico Administrativo":
"119 del Estatuto del Régimen Jurídico Administrativo de la Función Ejecutiva")+", y encontrándose dentro del "+
"término que se encuentra recurriendo, procede a amplicar el mismo, que fue otorgado mediante Notificación No. "+
$F{notificacion}+" notificada el "+new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format($F{fecha_notifica})+"; "+
"esto es, el "+($F{solicitud_senadi}.contains("SENADI")?"término":"plazo")+" de "+$P{dias_letras}+" ("+$F{dias_prorroga}+") días.\n"]]></variableExpression>
	</variable>
	<variable name="parrafo_3" class="java.lang.String">
		<variableExpression><![CDATA["<style pdfFontName='Times-Bold'>Notifíquese.- </style> "+$P{nombrePersona}+", "+
"<style pdfFontName='Times-Bold'>"+$P{delegacion}+".</style>\n"]]></variableExpression>
	</variable>
	<variable name="parrafo_4" class="java.lang.String">
		<variableExpression><![CDATA["<style pdfFontName='Times-Bold'>RAZÓN.-</style> Siento por tal que el día de hoy "+
new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy").format(new java.util.Date())+ ", notifiqué "+
"con la resolución que antecede a "+$F{solicitante}+", en el casillero virtual Nro. "+$F{casillero_senadi}+
" correspondiente a su apoderado/a "+$F{ape_apod_repre}+".- lo que certifico por delegación de la directora "+
"general del Servicio Nacional de Derechos Intelectuales, conferido mediante Resolución Nro. "+$P{resolucionnot}+"."]]></variableExpression>
	</variable>
